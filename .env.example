NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Supabase connection details
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_public_key
SUPABASE_SECRET_KEY=sb_secret_your_server_only_key

# mcp connection details
MCP_RESOURCE_URL=http://localhost:3000/mcp
MCP_AUTHORIZATION_SERVER_URL=http://localhost:3000/mcp
MCP_CLIENT_ID=claude
MCP_REDIRECT_URI=http://localhost:5173/mcp/authorize
MCP_AUTH_UI_URL=http://localhost:5173/mcp/authorize

# Redis connection details
REDIS_REST_URL=https://your-redis-instance.upstash.io
REDIS_REST_TOKEN=your-redis-rest-token